generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  PROCUREMENT_OFFICER
  VENDOR
}

enum VendorStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum RfqStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuotationStatus {
  SUBMITTED
  SELECTED
  REJECTED
}

enum PoStatus {
  GENERATED
  SENT
  FULFILLED
}

enum InvoiceStatus {
  PENDING_PAYMENT
  PAID
  OVERDUE
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         Role
  vendorId     String?
  vendor       Vendor?       @relation(fields: [vendorId], references: [id])
  createdRFQs  RFQ[]         @relation("UserCreatedRFQs")
  activityLogs ActivityLog[]
}

model Vendor {
  id             String          @id @default(uuid())
  companyName    String
  category       String
  gstNumber      String          @unique
  contactEmail   String
  contactPhone   String
  address        String
  status         VendorStatus
  rating         Float           @default(0.0)
  users          User[]
  assignedRFQs   RFQ[]           @relation("AssignedVendors")
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
}

model RFQ {
  id              String          @id @default(uuid())
  title           String
  description     String
  category        String
  deadline        DateTime
  status          RfqStatus
  attachmentUrl   String?
  createdById     String
  createdBy       User            @relation("UserCreatedRFQs", fields: [createdById], references: [id])
  lineItems       RfqLineItem[]
  quotations      Quotation[]
  assignedVendors Vendor[]        @relation("AssignedVendors")
  purchaseOrders  PurchaseOrder[]
}

model RfqLineItem {
  id       String @id @default(uuid())
  rfqId    String
  rfq      RFQ    @relation(fields: [rfqId], references: [id])
  item     String
  quantity Int
  unit     String
}

model Quotation {
  id                 String              @id @default(uuid())
  rfqId              String
  rfq                RFQ                 @relation(fields: [rfqId], references: [id])
  vendorId           String
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  subtotal           Float
  gstPercentage      Float
  grandTotal         Float
  deliveryDays       Int
  paymentTerms       String
  status             QuotationStatus
  approvalRemarks    String?
  quotationLineItems QuotationLineItem[]
  purchaseOrders     PurchaseOrder[]
}

model QuotationLineItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  item        String
  unitPrice   Float
  total       Float
}

model PurchaseOrder {
  id          String    @id @default(uuid())
  poNumber    String    @unique
  rfqId       String
  rfq         RFQ       @relation(fields: [rfqId], references: [id])
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  poDate      DateTime
  totalAmount Float
  status      PoStatus
  invoice     Invoice?
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  poId          String        @unique
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  issueDate     DateTime
  dueDate       DateTime
  cgst          Float
  sgst          Float
  grandTotal    Float
  status        InvoiceStatus
}

model ActivityLog {
  id            String   @id @default(uuid())
  action        String
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  entityType    String
  entityId      String
  createdAt     DateTime @default(now())
}
